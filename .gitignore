# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.tmp-check/
.expo-export-check/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# `.env` is NOT covered by the pattern above, and EXPO_PUBLIC_* values get
# inlined into the bundle — so an un-ignored .env is a credential leak waiting
# to happen. Ignore it explicitly; .env.example is the tracked template.
.env

# typescript
*.tsbuildinfo

# Supabase CLI local cache (version-check state, not project source)
supabase/.temp/

# generated native folders
/ios
/android
